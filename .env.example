# Neon Database Connection
# Get your DATABASE_URL from: https://console.neon.tech/
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Optional: AI enrichment
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# App URL (used by payment redirects)
# Production example: https://redinmo.io
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Payphone (Cajita de Pagos) - active payment provider (Ecuador only).
# Token = server-side, used to confirm transactions (src/lib/real-estate/payments/payphone.ts).
PAYPHONE_TOKEN=
# NEXT_PUBLIC_PAYPHONE_TOKEN = client-side, used to render the checkout box.
NEXT_PUBLIC_PAYPHONE_TOKEN=
PAYPHONE_ENV=test
# Optional per Payphone docs - leave empty until you have one.
NEXT_PUBLIC_PAYPHONE_STORE_ID=
# Coding password from Payphone Developer's panel - used ONLY to encrypt the
# cardHolder field for tokenized/recurring charges (src/lib/real-estate/
# payments/payphone.ts, encryptCardHolder()). Required for card tokenization
# to work; without it, subscriptions still activate but never save a card
# (see PaymentMethod/Subscription in prisma/schema.prisma).
PAYPHONE_CODING_PASSWORD=
# Your own key for encrypting the Payphone card token (ctoken) at rest
# (src/lib/real-estate/payments/encryption.ts) - NEVER reuse
# PAYPHONE_CODING_PASSWORD here, this is a separate secret only we know.
# 64 hex chars (32 bytes) is used as-is; anything else is hashed with
# SHA-256 into 32 bytes. Generate one with: openssl rand -hex 32
ENCRYPTION_KEY=

# PayPal - INACTIVE. Kept commented for the day Redinmo expands beyond Ecuador
# (see src/lib/real-estate/payments/paypal.ts and subscription-config.ts's
# provider selector, which always returns 'PAYPHONE' today). Uncomment and
# fill in only when reactivating that adapter.
# PAYPAL_MODE=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_PLAN_ID=
# PAYPAL_WEBHOOK_ID=

# Email notifications (welcome, matches, password recovery) via Resend.
# Get your RESEND_API_KEY from: https://resend.com/api-keys
# Empty = notifications are simulated (no-op, isEmailConfigured() = false)
RESEND_API_KEY=
RESEND_FROM_EMAIL=notificaciones@redinmo.io

# Support WhatsApp number (country code, no +, e.g. 593999999999) for the
# fallback link on /recuperar-acceso. Empty = the link is hidden.
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Local fallback mode (true for demo without DB/Stripe)
USE_REAL_ESTATE_MOCK=false

# Auth / security
AUTH_SECRET=change-me-super-secret
ADMIN_EMAIL=admin@brokerhub.local
ADMIN_PASSWORD=change-me-admin-password
TENANT_ID=brokerhub

# Protects /api/real-estate/cron/* from being called by anyone but Vercel
# Cron (which sends this automatically as a Bearer header once set). Without
# it, isAuthorized() in cron/billing/route.ts lets ANY request through - not
# just "optional hardening", set it before turning BILLING_ENABLED on.
CRON_SECRET=

# Interruptor general del cobro recurrente (fase de cierre, punto 1.1) -
# src/app/api/real-estate/cron/billing/route.ts corta ANTES de tocar la base
# si esto no es exactamente "true". Dejar en "false" (o sin definir) mientras
# se termina de verificar todo lo demas de esta lista.
BILLING_ENABLED=false
# Modo simulacion (punto 1.2) - con BILLING_ENABLED=true pero esto en "true"
# (el default si no se define), el cron recorre las suscripciones vencidas,
# arma el body que le mandaria a Payphone y lo registra como evento
# dry_run_charge, pero nunca llama a Payphone ni cobra un centavo. Poner
# "false" es lo que activa el cobro real.
BILLING_DRY_RUN=true