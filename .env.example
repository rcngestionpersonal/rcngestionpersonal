# Neon Database Connection
# Get your DATABASE_URL from: https://console.neon.tech/
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Optional: AI enrichment
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# App URL (used by PayPal redirects)
# Production example: https://redinmo.io
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PayPal subscriptions (Billing Plans API - server-side, used by admin/checkout fallback)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PLAN_ID=
PAYPAL_WEBHOOK_ID=

# PayPal Smart Buttons (client-side, used by the agent's own "Suscripcion" tab).
# Public values from PayPal's Button Factory - safe to expose to the browser.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_PLAN_ID=

# Email notifications (welcome, matches, password recovery) via Resend.
# Get your RESEND_API_KEY from: https://resend.com/api-keys
# Empty = notifications are simulated (no-op, isEmailConfigured() = false)
RESEND_API_KEY=
RESEND_FROM_EMAIL=notificaciones@redinmo.io

# Support WhatsApp number (country code, no +, e.g. 593999999999) for the
# fallback link on /recuperar-acceso. Empty = the link is hidden.
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Local fallback mode (true for demo without DB/Stripe)
USE_REAL_ESTATE_MOCK=false

# Auth / security
AUTH_SECRET=change-me-super-secret
ADMIN_EMAIL=admin@brokerhub.local
ADMIN_PASSWORD=change-me-admin-password
TENANT_ID=brokerhub
