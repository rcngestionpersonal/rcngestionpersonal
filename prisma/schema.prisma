// This is your Prisma schema file.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OperationType {
  SALE
  RENT
  BOTH
}

enum PropertyType {
  HOUSE
  APARTMENT
  SUITE
  OFFICE
  LAND
  COMMERCIAL
  WAREHOUSE
  FARM
  OTHER
}

enum LeadStage {
  NEW
  PROCESSING
  ACTIVE_MATCH
  CLOSED
  DISCARDED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  INACTIVE
}

enum PlanTipo {
  BASICO
  PRO
}

enum MatchStatus {
  PENDING
  CONTACTED
  INTERESTED
  REJECTED
  WON
  LOST
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum ListingStatus {
  ACTIVE
  RESERVED
  SOLD
  RENTED
  INACTIVE
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

model Agent {
  id                    String             @id @default(cuid())
  fullName              String
  phone                 String             @unique
  email                 String?            @unique
  // Correo nuevo a la espera de verificacion (seccion 3.4 - editar perfil): el
  // correo actual sigue vigente hasta que se confirme el nuevo via
  // EmailChangeToken. Nunca se escribe directo a "email" antes de confirmar.
  pendingEmail          String?
  passwordHash          String?
  // Cuentas de prueba (QA) creadas durante desarrollo: se excluyen del ranking publico
  // y de los contadores, pero no se borran (conservan el historial de pruebas).
  isTestUser            Boolean            @default(false)
  photoUrl              String?
  company               String?
  idNumber              String?
  licenseNumber         String?
  // Direccion profesional (Fase 7, seccion 8) - para cartas de presentacion,
  // fichas de inmueble, mini-sitio Pro, facturacion electronica y el campo
  // order.billTo que pedira la tokenizacion de Payphone. Nunca visible para
  // otros agentes, en el ranking, ni en la verificacion publica del carnet -
  // solo se usa en documentos que el propio agente genera. Todo nullable
  // para no romper agentes existentes.
  direccion             String?
  referenciaDireccion   String?
  ciudad                String?
  provincia             String?
  codigoPostal          String?
  phoneVerifiedAt       DateTime?
  otpCode               String?
  otpExpiresAt          DateTime?
  zones                 String[]
  propertyTypesInterest PropertyType[]
  minBudget             Float?
  maxBudget             Float?
  specialty             OperationType      @default(BOTH)
  isActive              Boolean            @default(true)
  trialEndsAt           DateTime
  subscriptionStatus    SubscriptionStatus @default(TRIAL)
  // PayPal queda inactivo (ver src/lib/real-estate/payments/paypal.ts) - estos
  // dos campos se conservan sin uso activo para no romper el historico ni la
  // reactivacion futura del adaptador para agentes fuera de Ecuador.
  paypalSubscriptionId  String?
  paypalPayerId         String?
  // Pago activo via Payphone (Cajita de Pagos - un cobro puntual que extiende
  // el acceso, no una suscripcion recurrente real): subscriptionPaidUntil es
  // la fecha hasta la que el ultimo pago cubre el acceso.
  lastPaymentProvider   String?
  payphoneTransactionId String?
  subscriptionPaidUntil DateTime?
  // Plan Basico/Pro (ver src/config/planes.ts). Durante el TRIAL el acceso es
  // Pro completo sin importar este valor (reverse trial) - plan es lo que
  // aplica una vez la suscripcion es ACTIVE. planSiguiente es un cambio de
  // plan programado (upgrade o downgrade) que el cron de renovacion aplica en
  // la proxima fecha de vencimiento y luego limpia.
  plan                  PlanTipo           @default(BASICO)
  planDesde             DateTime?
  planSiguiente         PlanTipo?
  // Precio fundador (Fase 7, seccion 9.4): el total en centavos (con IVA) que
  // este agente paga por el plan Basico, congelado desde que activo su
  // primera suscripcion Basico - se cobra ESE precio en vez del vigente
  // mientras la suscripcion siga activa e ininterrumpida. Se recalcula al
  // precio vigente si cancela y vuelve a suscribirse; se CONSERVA si pasa a
  // Pro y luego vuelve a Basico sin haber cancelado. Nunca aplica al plan Pro.
  precioFundadorBasico  Int?
  transacciones         Transaccion[]
  referredByAgentId     String?
  rankingAlias          String?
  useRankingAlias       Boolean            @default(false)
  // Carnet de Agente: zonas de especializacion (max 3, validado en el endpoint,
  // catalogo de src/lib/real-estate/quito-zones.ts), mensaje de WhatsApp
  // precargado en el QR del carnet, y slug unico para la pagina publica de
  // verificacion en vivo (redinmo.io/v/[slug]).
  specializationZones   String[]           @default([])
  carnetMessage         String?
  carnetSlug            String?            @unique
  // Anos de experiencia en el mercado inmobiliario (autodeclarados por el
  // agente) - se muestran en el Carnet como dato de confianza para la comunidad.
  yearsExperience       Int?
  // Preferencia de tema claro/oscuro/automatico - localStorage es el respaldo
  // inmediato (evita parpadeo), esto es la fuente de verdad multi-dispositivo.
  themePreference       ThemePreference    @default(LIGHT)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  matches               AgentMatch[]
  claimedOpportunities  Opportunity[]      @relation("OpportunityClaimedBy")
  referredOpportunities Opportunity[]      @relation("OpportunityReferredBy")
  createdOpportunities  Opportunity[]      @relation("OpportunityCreatedBy")
  listingsManaged       Listing[]          @relation("ListingManagedBy")
  listingsReferred      Listing[]          @relation("ListingReferredBy")
  notificationLogs      NotificationLog[]
  interactions          InteractionLog[]
  passwordResetTokens   PasswordResetToken[]
  emailChangeTokens     EmailChangeToken[]
}

model Listing {
  id                     String        @id @default(cuid())
  title                  String
  operationType          OperationType
  propertyType           PropertyType
  city                   String
  zone                   String?
  address                String?
  price                  Float
  currency               String        @default("USD")
  areaM2                 Float?
  bedrooms               Int?
  bathrooms              Int?
  parkingSpaces          Int?
  description            String?
  // Datos del cliente propietario/arrendador: estrictamente privados, solo el agente
  // que gestiona el inmueble puede verlos (ver src/lib/real-estate/privacy.ts).
  ownerName              String?
  ownerPhone             String?
  // URL en Vercel Blob (nunca la imagen en si) de la foto de portada del inmueble.
  coverPhotoUrl          String?
  commissionSharePercent Float         @default(0)
  status                 ListingStatus @default(ACTIVE)
  managingAgent          Agent         @relation("ListingManagedBy", fields: [managingAgentId], references: [id], onDelete: Cascade)
  managingAgentId        String
  referredByAgent        Agent?        @relation("ListingReferredBy", fields: [referredByAgentId], references: [id], onDelete: SetNull)
  referredByAgentId      String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  matches                ListingMatch[]

  @@index([city, propertyType, operationType])
  @@index([status])
}

model Opportunity {
  id               String          @id @default(cuid())
  contactName      String?
  contactPhone     String?
  operationType    OperationType
  propertyType     PropertyType
  city             String
  zone             String?
  address          String?
  budgetMin        Float?
  budgetMax        Float?
  areaM2           Float?
  bedrooms         Int?
  bathrooms        Int?
  parkingSpaces    Int?
  summary          String
  extractedData    Json?
  stage            LeadStage       @default(NEW)
  claimedByAgent   Agent?          @relation("OpportunityClaimedBy", fields: [claimedByAgentId], references: [id], onDelete: SetNull)
  claimedByAgentId String?
  referredByAgent  Agent?          @relation("OpportunityReferredBy", fields: [referredByAgentId], references: [id], onDelete: SetNull)
  referredByAgentId String?
  referralCommissionPercent Float?
  createdByAgent   Agent?          @relation("OpportunityCreatedBy", fields: [createdByAgentId], references: [id], onDelete: SetNull)
  createdByAgentId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  matches          AgentMatch[]
  listingMatches   ListingMatch[]
  notifications    NotificationLog[]
  interactions     InteractionLog[]

  @@index([city, propertyType, operationType])
  @@index([stage])
}

model ListingMatch {
  id            String      @id @default(cuid())
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  opportunityId String
  listing       Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId     String
  score         Float
  reasons       String[]
  status        MatchStatus @default(PENDING)
  contactedAt   DateTime?
  infoSentAt        DateTime?
  visitFollowUpAt   DateTime?
  visitScheduledFor DateTime?
  visitCompletedAt  DateTime?
  visitOutcome      String?
  offerInProgressAt DateTime?
  closedWon     Boolean?
  closedAt      DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  notifications NotificationLog[]

  @@unique([opportunityId, listingId])
  @@index([score])
}

model AgentMatch {
  id            String            @id @default(cuid())
  opportunity   Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  opportunityId String
  agent         Agent             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId       String
  score         Float
  reasons       String[]
  status        MatchStatus       @default(PENDING)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  notifications NotificationLog[]

  @@unique([opportunityId, agentId])
  @@index([score])
}

model NotificationLog {
  id                String         @id @default(cuid())
  channel           String
  content           String
  status            DeliveryStatus @default(QUEUED)
  providerMessageId String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  errorDetail       String?
  createdAt         DateTime       @default(now())
  agent             Agent?         @relation(fields: [agentId], references: [id], onDelete: SetNull)
  agentId           String?
  opportunity       Opportunity?   @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  opportunityId     String?
  match             AgentMatch?    @relation(fields: [matchId], references: [id], onDelete: SetNull)
  matchId           String?
  listingMatch      ListingMatch?  @relation(fields: [listingMatchId], references: [id], onDelete: SetNull)
  listingMatchId    String?

  @@index([status])
}

model InteractionLog {
  id            String       @id @default(cuid())
  type          String
  detail        String?
  metadata      Json?
  createdAt     DateTime     @default(now())
  opportunity   Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  opportunityId String
  agent         Agent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)
  agentId       String?

  @@index([type])
  @@index([createdAt])
}

// Historial de pagos (un registro por cobro exitoso de la Cajita de Payphone).
// A diferencia de los campos en Agent (que solo guardan el ULTIMO pago), esto
// permite saber que plan y monto se cobro en cada transaccion.
model Transaccion {
  id                String   @id @default(cuid())
  agent             Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId           String
  plan              PlanTipo
  provider          String
  amountCents       Int
  taxCents          Int
  totalCents        Int
  providerTransactionId String?
  authorizationCode String?
  createdAt         DateTime @default(now())

  @@index([agentId])
}

// Aviso previo de cambio de precio (Fase 7, seccion 9.5) - los Terminos y
// Condiciones comprometen 30 dias de aviso antes de cualquier aumento. El
// precio en si sigue viviendo en src/config/planes.ts (cambiarlo requiere
// deploy); esta tabla es el mecanismo de AVISO: registra la intencion, la
// fecha en que entra en vigor, y sirve de bandera para que el cron sepa
// cuando notificar a los agentes afectados (nunca a los que tengan
// precioFundadorBasico vigente) y cuando marcar el aviso como aplicado.
model ScheduledPriceChange {
  id            String    @id @default(cuid())
  plan          PlanTipo
  newTotalCents Int
  effectiveAt   DateTime
  notifiedAt    DateTime?
  appliedAt     DateTime?
  createdAt     DateTime  @default(now())
}

model EventLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  eventType  String
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([eventType])
}

// Recuperacion de contrasena: solo se guarda el HASH del token (nunca el token en
// claro - ese vive unicamente en el enlace del correo). Tambien sirve como fuente
// de verdad para el rate limiting (contar filas recientes por agentId/requestIp),
// asi no hace falta una tabla de rate-limit aparte.
model PasswordResetToken {
  id        String    @id @default(cuid())
  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId   String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  requestIp String?

  @@index([tokenHash])
  @@index([agentId])
}

// Verificacion de cambio de correo (seccion 3.4 de editar perfil): igual patron
// que PasswordResetToken (hash del token, un solo uso, vencimiento). newEmail
// vive en el token, no en Agent.pendingEmail exclusivamente, para poder
// invalidar tokens viejos si el agente pide el cambio mas de una vez sin
// perder de vista a que correo apuntaba cada intento.
model EmailChangeToken {
  id        String    @id @default(cuid())
  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId   String
  newEmail  String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tokenHash])
  @@index([agentId])
}

// Registro de cierres (venta/alquiler concretado). El campo createdByAgentId nunca
// se expone en las respuestas de la API (solo se usa para calcular "canEdit" del
// propio agente): el objetivo publico es la data de precios sectorizados, no la autoria.
// "details" guarda los campos condicionales de la Seccion B (segun tipo de inmueble:
// independiente/conjunto, piso, ascensor, uso de suelo, etc.) - se mantienen en JSON
// porque varian por tipo y así se evita una explosion de columnas nulas.
model ClosedDeal {
  id               String        @id @default(cuid())
  operationType    OperationType
  propertyType     PropertyType
  city             String        @default("Quito")
  zone             String?
  sector           String?
  microzona        String?
  antiguedad       String?
  estadoInmueble   String?
  details          Json?
  latitude         Float?
  longitude        Float?
  price            Float
  publicationPrice Float?
  currency         String        @default("USD")
  areaM2           Float?
  landAreaM2       Float?
  bedrooms         Int?
  bathrooms        Int?
  parkingSpaces    Int?
  ageYears         Int?
  timeOnMarket     String?
  paymentMethod    String?
  financialEntity  String?
  approvalDelayed  Boolean?
  declaredAccurate Boolean       @default(true)
  createdByAgentId String?
  closedAt         DateTime      @default(now())
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([city, propertyType, operationType])
  @@index([zone])
}

