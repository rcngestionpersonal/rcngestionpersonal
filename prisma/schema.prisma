// This is your Prisma schema file.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OperationType {
  SALE
  RENT
  BOTH
}

enum PropertyType {
  HOUSE
  APARTMENT
  SUITE
  OFFICE
  LAND
  COMMERCIAL
  WAREHOUSE
  FARM
  OTHER
}

enum LeadStage {
  NEW
  PROCESSING
  ACTIVE_MATCH
  CLOSED
  DISCARDED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  INACTIVE
}

enum PlanTipo {
  BASICO
  PRO
}

enum MatchStatus {
  PENDING
  CONTACTED
  INTERESTED
  REJECTED
  WON
  LOST
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum ListingStatus {
  ACTIVE
  RESERVED
  SOLD
  RENTED
  INACTIVE
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

model Agent {
  id                    String               @id @default(cuid())
  fullName              String
  phone                 String               @unique
  email                 String?              @unique
  // Correo nuevo a la espera de verificacion (seccion 3.4 - editar perfil): el
  // correo actual sigue vigente hasta que se confirme el nuevo via
  // EmailChangeToken. Nunca se escribe directo a "email" antes de confirmar.
  pendingEmail          String?
  passwordHash          String?
  // Cuentas de prueba (QA) creadas durante desarrollo: se excluyen del ranking publico
  // y de los contadores, pero no se borran (conservan el historial de pruebas).
  isTestUser            Boolean              @default(false)
  // Excluye la cuenta del cron de cobro (ver cron/billing/route.ts): una
  // cuenta marcada asi NUNCA se cobra, pase lo que pase con su suscripcion.
  //
  // Se solapa a proposito con isTestUser pero NO es lo mismo y por eso son dos
  // campos: isTestUser es un filtro de PRESENTACION (ranking, contadores
  // publicos) que ya existia, isTestAccount es un freno de DINERO. Separarlos
  // permite, por ejemplo, una cuenta de demo visible en el ranking a la que
  // igual no se le cobra. Si en el futuro se decide que siempre van juntos,
  // consolidarlos es seguro - pero hay que hacerlo a proposito, no por
  // asumir que uno implica el otro.
  isTestAccount         Boolean              @default(false)
  photoUrl              String?
  company               String?
  // Cedula o RUC: la identidad REAL del agente, y por eso unica a nivel de
  // base y no solo validada en la ruta de registro. El telefono ya era unico,
  // pero eso no impedia que la misma persona se registrara dos veces con dos
  // numeros - paso en produccion (dos cuentas con la cedula 1710804954,
  // creadas con 4 minutos de diferencia porque el primer intento guardo un
  // telefono con el codigo de pais duplicado). Nullable: hay cuentas viejas
  // sin cedula cargada, y Postgres permite multiples NULL en un indice unico.
  // NO se puede poner @unique todavia: hay cedulas repetidas en produccion
  // (ver el reporte de la Fase 3). La validacion vive por ahora en la ruta de
  // registro; subirla aca es el paso siguiente, una vez consolidadas.
  idNumber              String?
  licenseNumber         String?
  // Direccion profesional (Fase 7, seccion 8) - para cartas de presentacion,
  // fichas de inmueble, mini-sitio Pro, facturacion electronica y el campo
  // order.billTo que pedira la tokenizacion de Payphone. Nunca visible para
  // otros agentes, en el ranking, ni en la verificacion publica del carnet -
  // solo se usa en documentos que el propio agente genera. Todo nullable
  // para no romper agentes existentes.
  direccion             String?
  referenciaDireccion   String?
  ciudad                String?
  provincia             String?
  codigoPostal          String?
  phoneVerifiedAt       DateTime?
  otpCode               String?
  otpExpiresAt          DateTime?
  zones                 String[]
  propertyTypesInterest PropertyType[]
  minBudget             Float?
  maxBudget             Float?
  specialty             OperationType        @default(BOTH)
  isActive              Boolean              @default(true)
  trialEndsAt           DateTime
  subscriptionStatus    SubscriptionStatus   @default(TRIAL)
  // PayPal queda inactivo (ver src/lib/real-estate/payments/paypal.ts) - estos
  // dos campos se conservan sin uso activo para no romper el historico ni la
  // reactivacion futura del adaptador para agentes fuera de Ecuador.
  paypalSubscriptionId  String?
  paypalPayerId         String?
  // Pago activo via Payphone (Cajita de Pagos - un cobro puntual que extiende
  // el acceso, no una suscripcion recurrente real): subscriptionPaidUntil es
  // la fecha hasta la que el ultimo pago cubre el acceso.
  lastPaymentProvider   String?
  payphoneTransactionId String?
  subscriptionPaidUntil DateTime?
  // Plan Basico/Pro (ver src/config/planes.ts). Durante el TRIAL el acceso es
  // Pro completo sin importar este valor (reverse trial) - plan es lo que
  // aplica una vez la suscripcion es ACTIVE. planSiguiente es un cambio de
  // plan programado (upgrade o downgrade) que el cron de renovacion aplica en
  // la proxima fecha de vencimiento y luego limpia.
  plan                  PlanTipo             @default(BASICO)
  planDesde             DateTime?
  planSiguiente         PlanTipo?
  // Precio fundador (Fase 7, seccion 9.4): el total en centavos (con IVA) que
  // este agente paga por el plan Basico, congelado desde que activo su
  // primera suscripcion Basico - se cobra ESE precio en vez del vigente
  // mientras la suscripcion siga activa e ininterrumpida. Se recalcula al
  // precio vigente si cancela y vuelve a suscribirse; se CONSERVA si pasa a
  // Pro y luego vuelve a Basico sin haber cancelado. Nunca aplica al plan Pro.
  precioFundadorBasico  Int?
  transacciones         Transaccion[]
  referredByAgentId     String?
  rankingAlias          String?
  useRankingAlias       Boolean              @default(false)
  // Carnet de Agente: zonas de especializacion (max 3, validado en el endpoint,
  // catalogo de src/lib/real-estate/quito-zones.ts), mensaje de WhatsApp
  // precargado en el QR del carnet, y slug unico para la pagina publica de
  // verificacion en vivo (redinmo.io/v/[slug]).
  specializationZones   String[]             @default([])
  carnetMessage         String?
  carnetSlug            String?              @unique
  // Anos de experiencia en el mercado inmobiliario (autodeclarados por el
  // agente) - se muestran en el Carnet como dato de confianza para la comunidad.
  yearsExperience       Int?
  // Preferencia de tema claro/oscuro/automatico - localStorage es el respaldo
  // inmediato (evita parpadeo), esto es la fuente de verdad multi-dispositivo.
  themePreference       ThemePreference      @default(LIGHT)
  // Aceptacion de Terminos y Privacidad al registrarse (fase de cierre,
  // punto 2.3.2) - termsAcceptedVersion guarda el numero de version vigente
  // al momento (ver TERMS_VERSION en legal.ts), no el texto completo: a
  // diferencia del consentimiento de tokenizacion (que sí versiona por texto
  // literal en SubscriptionEvent porque cada aceptacion es plata en juego),
  // esto es una aceptacion de una sola vez por cuenta. Null en cuentas
  // creadas antes de este campo (no se puede reconstruir retroactivamente).
  termsAcceptedAt       DateTime?
  termsAcceptedVersion  String?
  termsAcceptedIp       String?
  // HISTORICO. Registro de la aceptacion del aviso de modelos referenciales del
  // modulo de contratos, que existio mientras el aviso era una puerta bloqueante
  // con casilla obligatoria. Ese aviso se retiro al pasar las plantillas a
  // basarse en formatos de uso comun: hoy es una nota discreta bajo el selector
  // y no se acepta. Las columnas se conservan porque contienen aceptaciones
  // reales con su fecha, y borrarlas destruiria esa constancia.
  // Aceptacion del aviso de "modelos referenciales" del modulo de contratos
  // (punto 4.2.a). Se repite cada 90 dias y cada vez que cambia el texto, asi
  // que a diferencia de termsAccepted* esto NO es una aceptacion unica: se
  // sobrescribe con la ultima. Guarda la version del texto aceptado para que
  // un cambio de redaccion obligue a volver a aceptarlo.
  contratosAvisoAt      DateTime?
  contratosAvisoVersion String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  matches               AgentMatch[]
  claimedOpportunities  Opportunity[]        @relation("OpportunityClaimedBy")
  referredOpportunities Opportunity[]        @relation("OpportunityReferredBy")
  createdOpportunities  Opportunity[]        @relation("OpportunityCreatedBy")
  listingsManaged       Listing[]            @relation("ListingManagedBy")
  listingsReferred      Listing[]            @relation("ListingReferredBy")
  notificationLogs      NotificationLog[]
  interactions          InteractionLog[]
  passwordResetTokens   PasswordResetToken[]
  emailChangeTokens     EmailChangeToken[]
  subscription          Subscription?
  paymentMethods        PaymentMethod[]
  miniSitio             MiniSitio?
  // Cartas de presentacion (Fase 4). "foto" | "logo": que imagen va en el
  // encabezado. Se recuerda entre cartas para no volver a preguntar.
  cartaImagenTipo       String?
  cartaLogoUrl          String?
  cartas                Carta[]
  cartaGeneraciones     CartaGeneracion[]
  contratos             Contrato[]
}

model Listing {
  id                      String         @id @default(cuid())
  title                   String
  operationType           OperationType
  propertyType            PropertyType
  city                    String
  zone                    String?
  address                 String?
  price                   Float
  currency                String         @default("USD")
  areaM2                  Float?
  bedrooms                Int?
  bathrooms               Int?
  parkingSpaces           Int?
  description             String?
  // Campos condicionales por tipo (Fase 8, Bloque A) - todos nullable y NINGUNO
  // filtra ni pondera el matching todavia (eso llega en el Bloque B, ver
  // src/lib/real-estate/matching.ts, sin tocar aqui). Un mismo campo se
  // reutiliza entre tipos cuando el significado es el mismo (antiguedad,
  // amoblado, piso/ascensor, estadoOcupacion) en vez de multiplicar columnas -
  // ver src/lib/real-estate/listing-fields.ts para que campo aplica a cada
  // PropertyType y sus valores permitidos.
  esIndependiente         Boolean?
  antiguedad              String?
  amoblado                String?
  alicuotaMensual         Float?
  piso                    Int?
  tieneAscensor           Boolean?
  areasComunales          Boolean?
  esquineroOMedianero     String?
  usoSueloTerreno         String?
  pisosPermitidos         Int?
  serviciosBasicos        String?
  frenteM                 Float?
  nivelLocal              String?
  distribucionLocal       String?
  estadoOcupacion         String?
  canonMensualActual      Float?
  alturaLibreM            Float?
  accesoCamion            Boolean?
  // Terreno y area libre de una Casa (seccion 2.1) - seleccion multiple, NUNCA
  // calculada por resta (construccion vs terreno total): el agente declara
  // cada metraje que aplique, independientemente. "Area verde amplia" es una
  // etiqueta DERIVADA (>250m2 en cualquiera de los tres) - se calcula en
  // listing-fields.ts, no se guarda en columna propia.
  terrenoTotalM2          Float?
  areaLibrePropiaM2       Float?
  terrenoLibreExclusivoM2 Float?
  // Espacios que el agente menciona verbalmente y que antes no existian como
  // dato (Fase 8, Bloque B, seccion 1.2) - Casa/Departamento/Suite/Oficina.
  // espaciosAdicionales pondera en el matching con peso 0.7 por unidad (ver
  // matching.ts); balconOTerraza es puramente informativo (nunca pondera).
  espaciosAdicionales     Int?
  mediosBanos             Int?
  balconOTerraza          Boolean?
  // Datos del cliente propietario/arrendador: estrictamente privados, solo el agente
  // que gestiona el inmueble puede verlos (ver src/lib/real-estate/privacy.ts).
  ownerName               String?
  ownerPhone              String?
  // URL en Vercel Blob (nunca la imagen en si) de la foto de portada del
  // inmueble - CAMPO DERIVADO desde Fase 4 (galeria de fotos): se mantiene en
  // sincronia con la ListingPhoto de orden 0 (ver
  // src/lib/real-estate/listing-photos-prisma.ts) exclusivamente para no
  // romper a los consumidores que ya leian este campo directo (tarjeta del
  // listado, ficha PDF). Ninguna ruta debe escribirlo a mano fuera de ese
  // helper, y NUNCA debe leerse como fuente de verdad de cual es la portada:
  // eso lo decide orden 0.
  coverPhotoUrl           String?
  commissionSharePercent  Float          @default(0)
  status                  ListingStatus  @default(ACTIVE)
  managingAgent           Agent          @relation("ListingManagedBy", fields: [managingAgentId], references: [id], onDelete: Cascade)
  managingAgentId         String
  referredByAgent         Agent?         @relation("ListingReferredBy", fields: [referredByAgentId], references: [id], onDelete: SetNull)
  referredByAgentId       String?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  matches                 ListingMatch[]
  photos                  ListingPhoto[]

  @@index([city, propertyType, operationType])
  @@index([status])
}

// Mini-sitio publico del agente (Fase 3, feature Pro "mini_sitio") -
// redinmo.io/a/[slug]. Es una fila aparte y no columnas en Agent porque casi
// todos sus campos solo existen si el agente activo la feature, y porque el
// slug tiene su propia regla de inmutabilidad.
//
// El slug se genera UNA vez al activar y no cambia nunca, ni aunque el agente
// edite su nombre: los enlaces ya compartidos (WhatsApp, tarjetas impresas,
// vitrinas) tienen que seguir funcionando. Cambiarlo es tarea de soporte.
//
// "activo" es solo la decision del agente. Que el sitio se vea o no depende
// ADEMAS de que tenga la feature vigente (tieneAcceso), que se evalua en cada
// request: si el plan baja a Basico o la suscripcion vence, el sitio muestra
// una pagina neutra pero la fila se conserva intacta para cuando reactive.
model MiniSitio {
  id                String            @id @default(cuid())
  agent             Agent             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId           String            @unique
  slug              String            @unique
  activo            Boolean           @default(false)
  // Clave de la paleta acotada (ver MINI_SITIO_COLORES en mini-sitio.ts) - a
  // proposito NO es un color libre: un agente eligiendo fucsia sobre verde
  // degrada la percepcion de toda la plataforma.
  colorAcento       String            @default("violeta")
  // No hay banderas para ocultar el inventario ni el formulario: las dos
  // secciones son obligatorias. Sin inventario el mini-sitio es una tarjeta de
  // presentacion sin sustancia, y sin formulario no genera negocio - son las
  // dos razones por las que existe la feature, y dejar apagarlas era dejar que
  // el agente la vaciara de valor sin darse cuenta.
  // Maximo 160 caracteres, validado en la ruta que la escribe.
  frasePresentacion String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  visitas           MiniSitioVisita[]

  @@index([activo])
}

// Una fila por visita (seccion 6: visitas de los ultimos 30 dias, inmueble mas
// visto, grafico por dia). Se guarda el evento crudo en vez de un contador
// agregado para poder responder las tres preguntas con la misma tabla; el
// volumen esperado lo justifica. listingId se llena solo cuando la visita fue
// al detalle de un inmueble, no a la portada del sitio.
//
// No guarda IP ni user-agent a proposito: alcanza para contar y evita
// convertir una metrica de vanidad en un tratamiento de datos personales que
// habria que declarar en el RAT.
model MiniSitioVisita {
  id          String    @id @default(cuid())
  miniSitio   MiniSitio @relation(fields: [miniSitioId], references: [id], onDelete: Cascade)
  miniSitioId String
  listingId   String?
  createdAt   DateTime  @default(now())

  @@index([miniSitioId, createdAt])
  @@index([miniSitioId, listingId])
}

// Galeria de fotos del inmueble (Fase 4) - el limite por inmueble depende del
// plan y se valida en la ruta de subida, no aqui. "orden" define la posicion
// en la grilla/carrusel empezando en 0, y orden 0 ES la portada: no hay
// bandera aparte. El invariante (orden contiguo desde 0, sin huecos ni
// duplicados) lo mantiene listing-photos-prisma.ts, nunca SQL.
model ListingPhoto {
  id           String   @id @default(cuid())
  listing      Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId    String
  url          String
  // Ruta interna en Vercel Blob (el pathname, no la URL publica) - es lo unico
  // con lo que se puede BORRAR el archivo. Sin esto, cada foto eliminada
  // quedaba pagandose para siempre en Blob (ver el bug 5.3 del pedido de
  // galeria). Nullable solo por las filas anteriores a este campo: las nuevas
  // siempre la traen, y el backfill la derivo de la URL.
  ruta         String?
  miniaturaUrl String?
  ancho        Int?
  alto         Int?
  tamanoBytes  Int?
  // orden = 0 es LA portada. Unica fuente de verdad: antes convivian tres
  // (esPortada, orden y Listing.coverPhotoUrl) y se desincronizaban.
  // Listing.coverPhotoUrl queda como campo derivado de la foto con orden 0,
  // nunca como fuente.
  orden        Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([listingId, orden])
}

model Opportunity {
  id                        String            @id @default(cuid())
  contactName               String?
  contactPhone              String?
  operationType             OperationType
  propertyType              PropertyType
  city                      String
  zone                      String?
  address                   String?
  budgetMin                 Float?
  budgetMax                 Float?
  areaM2                    Float?
  bedrooms                  Int?
  bathrooms                 Int?
  parkingSpaces             Int?
  // Interruptores de preferencia (Fase 8, seccion 3.2) - sí/no/indiferente,
  // 'SI'|'NO'|null (indiferente = no pondera nada, ver Bloque B). Los
  // numericos de arriba (bedrooms/bathrooms/parkingSpaces/areaM2) se
  // reinterpretan como "minimo deseado" para pedidos, sin necesidad de
  // columnas nuevas - nunca se usaron como valor exacto en el matching.
  prefAreaVerdeAmplia       String?
  prefAreasComunales        String?
  prefAscensor              String?
  prefAmoblado              String?
  prefTodosLosServicios     String?
  // Fase 8, Bloque B, seccion 1.3a - null o true = acepta que espacios
  // adicionales del inmueble (estudio, cuarto de servicio) cuenten como
  // dormitorio con peso 0.7 (checkbox marcado por defecto); false = solo
  // cuentan los dormitorios reales. Solo aplica si bedrooms esta definido.
  aceptaEspaciosAdicionales Boolean?
  summary                   String
  extractedData             Json?
  // De donde salio el pedido: "manual" (el agente lo cargo), "mini_sitio" (lo
  // envio un tercero por el formulario de captacion de /a/[slug], Fase 3) o
  // "web_chat". El panel los muestra diferenciados: un pedido entrante no es
  // lo mismo que uno que el agente escribio, ni en confianza del dato ni en
  // urgencia de respuesta.
  origen                    String            @default("manual")
  stage                     LeadStage         @default(NEW)
  claimedByAgent            Agent?            @relation("OpportunityClaimedBy", fields: [claimedByAgentId], references: [id], onDelete: SetNull)
  claimedByAgentId          String?
  referredByAgent           Agent?            @relation("OpportunityReferredBy", fields: [referredByAgentId], references: [id], onDelete: SetNull)
  referredByAgentId         String?
  referralCommissionPercent Float?
  createdByAgent            Agent?            @relation("OpportunityCreatedBy", fields: [createdByAgentId], references: [id], onDelete: SetNull)
  createdByAgentId          String?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  matches                   AgentMatch[]
  listingMatches            ListingMatch[]
  notifications             NotificationLog[]
  interactions              InteractionLog[]

  @@index([city, propertyType, operationType])
  @@index([stage])
}

model ListingMatch {
  id                String            @id @default(cuid())
  opportunity       Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  opportunityId     String
  listing           Listing           @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId         String
  score             Float
  reasons           String[]
  status            MatchStatus       @default(PENDING)
  contactedAt       DateTime?
  infoSentAt        DateTime?
  visitFollowUpAt   DateTime?
  visitScheduledFor DateTime?
  visitCompletedAt  DateTime?
  visitOutcome      String?
  offerInProgressAt DateTime?
  closedWon         Boolean?
  closedAt          DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  notifications     NotificationLog[]

  @@unique([opportunityId, listingId])
  @@index([score])
}

model AgentMatch {
  id            String            @id @default(cuid())
  opportunity   Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  opportunityId String
  agent         Agent             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId       String
  score         Float
  reasons       String[]
  status        MatchStatus       @default(PENDING)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  notifications NotificationLog[]

  @@unique([opportunityId, agentId])
  @@index([score])
}

model NotificationLog {
  id                String         @id @default(cuid())
  channel           String
  content           String
  status            DeliveryStatus @default(QUEUED)
  providerMessageId String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  errorDetail       String?
  createdAt         DateTime       @default(now())
  agent             Agent?         @relation(fields: [agentId], references: [id], onDelete: SetNull)
  agentId           String?
  opportunity       Opportunity?   @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  opportunityId     String?
  match             AgentMatch?    @relation(fields: [matchId], references: [id], onDelete: SetNull)
  matchId           String?
  listingMatch      ListingMatch?  @relation(fields: [listingMatchId], references: [id], onDelete: SetNull)
  listingMatchId    String?

  @@index([status])
}

model InteractionLog {
  id            String      @id @default(cuid())
  type          String
  detail        String?
  metadata      Json?
  createdAt     DateTime    @default(now())
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  opportunityId String
  agent         Agent?      @relation(fields: [agentId], references: [id], onDelete: SetNull)
  agentId       String?

  @@index([type])
  @@index([createdAt])
}

// Historial de pagos (un registro por cobro exitoso de la Cajita de Payphone).
// A diferencia de los campos en Agent (que solo guardan el ULTIMO pago), esto
// permite saber que plan y monto se cobro en cada transaccion.
model Transaccion {
  id                    String   @id @default(cuid())
  agent                 Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId               String
  plan                  PlanTipo
  provider              String
  amountCents           Int
  taxCents              Int
  totalCents            Int
  providerTransactionId String?
  authorizationCode     String?
  createdAt             DateTime @default(now())

  @@index([agentId])
}

// Aviso previo de cambio de precio (Fase 7, seccion 9.5) - los Terminos y
// Condiciones comprometen 30 dias de aviso antes de cualquier aumento. El
// precio en si sigue viviendo en src/config/planes.ts (cambiarlo requiere
// deploy); esta tabla es el mecanismo de AVISO: registra la intencion, la
// fecha en que entra en vigor, y sirve de bandera para que el cron sepa
// cuando notificar a los agentes afectados (nunca a los que tengan
// precioFundadorBasico vigente) y cuando marcar el aviso como aplicado.
model ScheduledPriceChange {
  id            String    @id @default(cuid())
  plan          PlanTipo
  newTotalCents Int
  effectiveAt   DateTime
  notifiedAt    DateTime?
  appliedAt     DateTime?
  createdAt     DateTime  @default(now())
}

model EventLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  eventType  String
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([eventType])
}

// Recuperacion de contrasena: solo se guarda el HASH del token (nunca el token en
// claro - ese vive unicamente en el enlace del correo). Tambien sirve como fuente
// de verdad para el rate limiting (contar filas recientes por agentId/requestIp),
// asi no hace falta una tabla de rate-limit aparte.
model PasswordResetToken {
  id        String    @id @default(cuid())
  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId   String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  requestIp String?

  @@index([tokenHash])
  @@index([agentId])
}

// Verificacion de cambio de correo (seccion 3.4 de editar perfil): igual patron
// que PasswordResetToken (hash del token, un solo uso, vencimiento). newEmail
// vive en el token, no en Agent.pendingEmail exclusivamente, para poder
// invalidar tokens viejos si el agente pide el cambio mas de una vez sin
// perder de vista a que correo apuntaba cada intento.
model EmailChangeToken {
  id        String    @id @default(cuid())
  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId   String
  newEmail  String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tokenHash])
  @@index([agentId])
}

// Registro de cierres (venta/alquiler concretado). El campo createdByAgentId nunca
// se expone en las respuestas de la API (solo se usa para calcular "canEdit" del
// propio agente): el objetivo publico es la data de precios sectorizados, no la autoria.
// "details" guarda los campos condicionales de la Seccion B (segun tipo de inmueble:
// independiente/conjunto, piso, ascensor, uso de suelo, etc.) - se mantienen en JSON
// porque varian por tipo y así se evita una explosion de columnas nulas.
model ClosedDeal {
  id               String        @id @default(cuid())
  operationType    OperationType
  propertyType     PropertyType
  city             String        @default("Quito")
  zone             String?
  sector           String?
  microzona        String?
  antiguedad       String?
  estadoInmueble   String?
  details          Json?
  latitude         Float?
  longitude        Float?
  price            Float
  publicationPrice Float?
  currency         String        @default("USD")
  areaM2           Float?
  landAreaM2       Float?
  bedrooms         Int?
  bathrooms        Int?
  parkingSpaces    Int?
  ageYears         Int?
  timeOnMarket     String?
  paymentMethod    String?
  financialEntity  String?
  approvalDelayed  Boolean?
  declaredAccurate Boolean       @default(true)
  createdByAgentId String?
  closedAt         DateTime      @default(now())
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([city, propertyType, operationType])
  @@index([zone])
}

enum ChargeStatus {
  PENDING
  APPROVED
  DECLINED
  ERROR
  REVERSED
}

// Motor de cobro recurrente por token de Payphone (Cajita + /transaction/web).
// Subscription.status REUSA el enum SubscriptionStatus que ya lee
// tieneAcceso()/tieneAccesoPorAgenteId() desde Agent.subscriptionStatus a
// proposito: esta tabla es el detalle mecanico del cobro (periodos,
// reintentos, tarjeta), pero Agent.subscriptionStatus/plan/
// subscriptionPaidUntil siguen siendo la fuente que consulta el resto de la
// app para gatear features - toda transicion de estado de esta tabla debe
// escribir tambien esos campos en Agent, nunca reemplazarlos.
model Subscription {
  id                String              @id @default(cuid())
  agent             Agent               @relation(fields: [agentId], references: [id])
  agentId           String              @unique
  plan              PlanTipo
  status            SubscriptionStatus  @default(TRIAL)
  amountCents       Int
  taxCents          Int
  trialEndsAt       DateTime?
  currentPeriodEnd  DateTime?
  nextChargeAt      DateTime?
  graceEndsAt       DateTime?
  canceledAt        DateTime?
  cancelAtPeriodEnd Boolean             @default(false)
  // Precio fundador (ver Agent.precioFundadorBasico, el dato ya vive ahi) -
  // esta bandera solo indica si ESTA suscripcion lo tiene vigente, para que
  // el cron sepa si debe cobrar el precio congelado en vez del de planes.ts.
  priceLocked       Boolean             @default(false)
  // Reclamo de fila del cron de cobro (paso 5, seccion 4 punto 2): se marca
  // con el momento en que un cron EN CURSO empezo a procesar esta
  // suscripcion, via UPDATE condicionado (compare-and-swap contra
  // claimedAt=null) - asi dos ejecuciones simultaneas no pueden cobrar la
  // misma fila, sin depender de un advisory lock de Postgres que Prisma no
  // expone directo. Se limpia (vuelve a null) al terminar de procesar la
  // fila, sea cual sea el resultado.
  claimedAt         DateTime?
  paymentMethodId   String?
  paymentMethod     PaymentMethod?      @relation(fields: [paymentMethodId], references: [id])
  charges           Charge[]
  events            SubscriptionEvent[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([status, nextChargeAt])
}

// ctoken de Payphone (nace de una transaccion aprobada, seccion 1 del pedido
// de recurrencias) - cardTokenEnc esta cifrado EN REPOSO con ENCRYPTION_KEY
// propia (AES-256-GCM, ver encryption.ts, paso 2). cardHolderEnc en cambio
// es el resultado de encryptCardHolder() (AES-256-CBC con la coding password
// de Payphone, IV en cero): como esa funcion es determinista, el mismo
// ciphertext se reenvia tal cual en cada cobro futuro - no hace falta volver
// a cifrar el nombre en cada intento, ni guardar el nombre en claro.
model PaymentMethod {
  id            String         @id @default(cuid())
  agent         Agent          @relation(fields: [agentId], references: [id])
  agentId       String
  cardTokenEnc  String
  cardHolderEnc String
  brand         String
  lastDigits    String
  bin           String?
  email         String
  phoneNumber   String
  documentId    String
  consentAt     DateTime
  consentIp     String
  consentText   String
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  subscriptions Subscription[]

  @@index([agentId])
}

// Un intento de cobro contra /transaction/web. El indice unico
// [subscriptionId, periodKey, attempt] es lo que hace idempotente al cron
// (seccion 4, punto 2): si dos ejecuciones intentan crear el mismo intento
// del mismo periodo, la segunda choca contra la restriccion en vez de cobrar
// dos veces. clientTransactionId es ademas unico globalmente porque asi lo
// exige Payphone (maximo 50 caracteres, se arma determinista a partir de
// subscriptionId/periodKey/attempt - ver billing.ts, paso 5).
model Charge {
  id                  String       @id @default(cuid())
  subscription        Subscription @relation(fields: [subscriptionId], references: [id])
  subscriptionId      String
  periodKey           String
  attempt             Int
  // Reintentos TECNICOS de este mismo intento (timeout / red caida / HTTP
  // 5xx de Payphone), contados aparte de `attempt` a proposito: `attempt`
  // cuenta rechazos REALES del banco y es lo que consume la ventana 0/3/7,
  // mientras que un timeout no dice nada sobre la tarjeta y no deberia
  // gastar uno de los tres intentos del agente. Ver
  // MAX_UNKNOWN_ERROR_RETRIES en subscription-engine.ts.
  unknownErrorCount   Int          @default(0)
  clientTransactionId String       @unique
  amountCents         Int
  status              ChargeStatus @default(PENDING)
  payphoneTxId        String?
  authorizationCode   String?
  responseCode        String?
  responseMessage     String?
  rawResponse         Json?
  createdAt           DateTime     @default(now())
  resolvedAt          DateTime?

  @@unique([subscriptionId, periodKey, attempt])
  @@index([status])
}

// Bitacora de la suscripcion (seccion 2 del pedido: "innegociable" para
// disputas de cobro) - nunca se edita ni se borra, solo se agrega. type usa
// string libre (trial_started, card_saved, charge_approved,
// charge_declined, downgraded, etc.) en vez de un enum para no requerir
// migracion cada vez que el motor aprenda un evento nuevo.
model SubscriptionEvent {
  id             String       @id @default(cuid())
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  subscriptionId String
  type           String
  payload        Json?
  createdAt      DateTime     @default(now())

  @@index([subscriptionId, createdAt])
}

// ---------------------------------------------------------------------------
// CARTAS DE PRESENTACION (Fase 4) - feature Pro "carta_presentacion".
// ---------------------------------------------------------------------------

// A quien va dirigida la carta. Define el enfoque del texto, no solo el
// saludo: una propuesta a una constructora y una carta a un propietario
// argumentan cosas distintas (ver CARTA_DESTINATARIOS en cartas/tipos.ts).
enum CartaDestinatario {
  PROPIETARIO
  COLEGA
  CONSTRUCTORA
  EMPRESA
}

enum CartaEstado {
  BORRADOR
  ENVIADA
}

model Carta {
  id      String @id @default(cuid())
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId String

  destinatarioTipo   CartaDestinatario
  destinatarioNombre String
  destinatarioCargo  String?
  // Una linea de contexto ("nos conocimos en la feria"). Es un dato de un
  // TERCERO: solo lo ve el agente que lo escribio (punto 7.1).
  contexto           String?

  // Los seis bloques del texto, cada uno editable por separado (punto 2.4).
  // Se guardan como objeto y no como un string unico justamente para que
  // "regenerar este parrafo" no tenga que rehacer la carta entera.
  bloques           Json
  // Los bloques TAL COMO los genero el modelo. Comparar contra "bloques" es lo
  // que permite saber que reescribio el agente y usar eso como referencia de
  // estilo en cartas futuras (punto 3.3), sin pedirle que califique nada.
  bloquesOriginales Json

  // Foto de los datos reales con los que se genero el texto. Es la evidencia
  // de que la carta no invento nada (punto 2.2): si mañana el agente registra
  // 10 cierres mas, esta carta sigue diciendo lo que era cierto ese dia.
  datosUsados Json

  // El agente decide si la carta lleva el enlace a su perfil profesional. Por
  // defecto si, pero solo tiene efecto cuando el mini-sitio esta publicado: sin
  // mini-sitio activo no hay enlace que poner, y un enlace roto en una carta de
  // presentacion es peor que no tener enlace.
  incluirMiniSitio Boolean @default(true)

  imagenTipo String      @default("foto")
  paleta     String      @default("clara")
  estado     CartaEstado @default(BORRADOR)

  // Nada se descarga ni se envia sin pasar por la revision (punto 3.5).
  revisadaAt DateTime?
  enviadaAt  DateTime?
  enviadaA   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId, createdAt])
}

// Una fila por llamada al modelo, sea una carta completa o la regeneracion de
// un parrafo. Se guarda el consumo real de tokens ademas del conteo para poder
// ajustar el limite con datos y no a ojo (punto 2.6).
model CartaGeneracion {
  id      String @id @default(cuid())
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId String

  // "carta" | "bloque"
  tipo          String
  cartaId       String?
  modelo        String?
  tokensEntrada Int?
  tokensSalida  Int?

  createdAt DateTime @default(now())

  @@index([agentId, createdAt])
}

// ---------------------------------------------------------------------------
// CONTRATOS (feature Pro "contratos") - generacion y firma por aceptacion
// remota.
//
// PRIVACIDAD: un contrato contiene cedulas, direcciones y montos de TERCEROS
// que nunca aceptaron los terminos de la plataforma. Por eso los datos de las
// partes y el registro probatorio se guardan CIFRADOS (AES-256-GCM, ver
// payments/encryption.ts) y solo los ve el agente que los genero. Nunca
// aparecen en el mini-sitio, el ranking ni ninguna vista publica.
// ---------------------------------------------------------------------------

enum ContratoTipo {
  CORRETAJE
  CORRETAJE_EXCLUSIVO
  CORRETAJE_ABIERTO
  ARRENDAMIENTO
  RESERVA_ARRIENDO
  RESERVA_COMPRAVENTA
}

enum ContratoEstado {
  BORRADOR
  PENDIENTE_FIRMA
  FIRMADO
  RECHAZADO
  ANULADO
}

enum FirmanteEstado {
  ENVIADO
  ABIERTO
  FIRMADO
  RECHAZADO
}

model Contrato {
  id      String @id @default(cuid())
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId String

  tipo ContratoTipo

  // Inmueble del inventario del agente. Se guarda ademas una foto de sus datos
  // en "datosCifrados": si el inmueble se edita o se borra despues, el
  // contrato firmado tiene que seguir diciendo lo que decia el dia que se
  // firmo.
  listingId String?

  // Version de la plantilla usada. Si mañana cambia el texto legal, los
  // contratos ya firmados conservan el suyo (punto 5.2).
  plantillaVersion String

  // Todos los campos del formulario, cifrados en reposo: aca viven las cedulas
  // y direcciones de las partes.
  datosCifrados String

  estado ContratoEstado @default(BORRADOR)

  // SHA-256 del PDF sellado. Es lo que permite demostrar que el documento no
  // se altero despues de la firma.
  hashDocumento String?

  // Codigo publico de verificacion (/c/[codigo]). Deliberadamente distinto del
  // id interno: el id no deberia poder adivinarse desde una URL compartida.
  codigoVerificacion String @unique

  anuladoNota String?

  enviadoAt DateTime?
  firmadoAt DateTime?
  anuladoAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  firmantes ContratoFirmante[]

  @@index([agentId, createdAt])
  @@index([estado])
}

model ContratoFirmante {
  id         String   @id @default(cuid())
  contrato   Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  contratoId String

  // Rol dentro del documento: "propietario", "arrendatario", "comprador"...
  rol           String
  nombre        String
  correo        String
  // Cedula completa cifrada. En claro solo se guardan los ultimos 4 digitos,
  // que son los que el firmante teclea para identificarse (punto 3.4) - con 4
  // digitos sueltos no se reconstruye una cedula.
  cedulaCifrada String
  cedulaUlt4    String

  // Hash del token del enlace, nunca el token: si alguien lee la base de datos
  // no puede firmar por nadie. El token viaja solo en el correo.
  tokenHash String   @unique
  expiraAt  DateTime

  estado FirmanteEstado @default(ENVIADO)

  enviadoAt      DateTime?
  abiertoAt      DateTime?
  firmadoAt      DateTime?
  rechazadoAt    DateTime?
  motivoRechazo  String?
  recordatorioAt DateTime?

  // Registro probatorio cifrado (punto 3.5): IP, navegador, dispositivo y
  // confirmacion de que desplazo el documento completo.
  evidenciaCifrada String?

  @@index([contratoId])
  @@index([estado, expiraAt])
}
